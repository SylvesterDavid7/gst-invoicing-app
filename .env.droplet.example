# 1. Shopify App Credentials (from Shopify Partner Dashboard)
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SCOPES=read_orders,write_orders,read_products,read_customers

# 2. Your App URL (either http://DROPLET_IP:3000 or your custom domain https://invoicing.yourdomain.com)
HOST=https://invoicing.yourdomain.com

# 3. Neon PostgreSQL Database URL
DATABASE_URL=postgresql://neondb_owner:npg_TtQC6ha0BgoK@ep-shiny-silence-azf6ec8o-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=30

# 4. Redis internal password (used between app & redis container)
REDIS_PASSWORD=strongredispass123

# 5. Storage Provider (LOCAL stores generated PDFs on Droplet persistent volume)
STORAGE_PROVIDER=LOCAL
PORT=3000
NODE_ENV=production

# 6. Admin Portal Master Password
ADMIN_PASSWORD=admin@gst2026
ADMIN_SECRET=gst-admin-supersecret-2026
