# Shopify App Credentials
SHOPIFY_API_KEY="your_api_key_here"
SHOPIFY_API_SECRET="your_api_secret_here"
SCOPES="read_orders,write_orders,read_products,read_customer_events,read_metaobjects"
HOST="https://your-tunnel-or-domain.ngrok.app"

# PostgreSQL Database (Mandatory for ACID transactions & row-locking sequence generation)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gst_invoicing_db?schema=public"

# Redis (BullMQ queue backend)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Cloud Storage (Cloudflare R2 or AWS S3 for zero-egress PDF downloads)
STORAGE_PROVIDER="R2" # "R2" or "S3" or "LOCAL"
S3_BUCKET_NAME="gst-invoices"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your_r2_access_key"
S3_SECRET_ACCESS_KEY="your_r2_secret_key"
S3_PUBLIC_DOMAIN="https://invoices.yourbrand.com"

# App Port
PORT=3000
NODE_ENV="development"
