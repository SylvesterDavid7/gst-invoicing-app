{
  "name": "shopify-gst-invoicing",
  "version": "1.0.0",
  "description": "Production-grade automated Indian GST Invoicing app for Shopify stores",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "remix vite:dev",
    "dev:all": "node scripts/dev-all.js",
    "build": "remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "worker": "tsx src/workers/index.ts",
    "start:all": "node scripts/start-all.js",
    "test:order": "tsx scripts/trigger-webhook.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "tsx --test app/services/tax-engine/calculator.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@remix-run/node": "^2.15.0",
    "@remix-run/react": "^2.15.0",
    "@remix-run/serve": "^2.15.0",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.0",
    "@shopify/shopify-api": "^11.5.0",
    "@shopify/shopify-app-remix": "^3.3.1",
    "@shopify/ui-extensions": "^2025.7.0",
    "@shopify/ui-extensions-react": "^2025.7.0",
    "bullmq": "^5.21.2",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "exceljs": "^3.4.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.4.1",
    "isbot": "^5.1.17",
    "puppeteer": "^25.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.15.0",
    "@types/node": "^22.8.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
